# The backend's gRPC address. The server functions dial this over native
# HTTP/2; it is never exposed to the browser.
SCHEMAFORGE_GRPC_ADDRESS="127.0.0.1:50051"

# Seals the cookie that holds each visitor's backend tokens, so they never
# reach the browser in the clear. Any 32 or more characters; make one with
# `openssl rand -base64 32`.
SCHEMAFORGE_SESSION_SECRET=""

# The directory holding the backend's proto files, and nothing else: the
# server loads schema.proto, health.proto and auth.proto from here to talk to
# the backend, so it has to be on this machine.
SCHEMAFORGE_PROTO_DIR="/home/you/code/schemaForgeBackend/proto/schemaforge/v1"

# How long one call to the backend may take before it is given up on.
# SCHEMAFORGE_RPC_TIMEOUT_MS="15000"
