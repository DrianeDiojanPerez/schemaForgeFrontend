		"dev": "vite dev --port 3100",
		"build": "vite build",
		"start": "node server.mjs",
		"preview": "vite preview",
		"test": "vitest run",
		"test:backend": "SCHEMAFORGE_TEST_BACKEND=\"${SCHEMAFORGE_TEST_BACKEND:-127.0.0.1:50051}\" vitest run src/server/rpc/backend.test.ts",
